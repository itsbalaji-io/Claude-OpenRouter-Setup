# Safe placeholder example for Claude Code + OpenRouter integration
# DO NOT commit real API keys to version control.
# The setup tool manages these variables in Windows User-level environment variables (HKCU\Environment).

# Your OpenRouter API Key (obtained from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# OpenRouter Anthropic-compatible API Base URL
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Anthropic Auth Token (mirrors OPENROUTER_API_KEY for Claude Code's Anthropic client)
ANTHROPIC_AUTH_TOKEN=sk-or-v1-your-openrouter-api-key-here

# ANTHROPIC_API_KEY must remain empty or unset to prevent Claude Code from calling Anthropic directly
ANTHROPIC_API_KEY=

# Target model identifier on OpenRouter
OPENROUTER_MODEL=recursive/flint-v1.0:free
ANTHROPIC_MODEL=recursive/flint-v1.0:free

# Model alias pinning for Claude Code
ANTHROPIC_DEFAULT_HAIKU_MODEL=recursive/flint-v1.0:free
ANTHROPIC_DEFAULT_SONNET_MODEL=recursive/flint-v1.0:free
ANTHROPIC_DEFAULT_OPUS_MODEL=recursive/flint-v1.0:free

# Custom model context window (in tokens) to avoid fallback warnings
CLAUDE_CODE_MAX_CONTEXT_TOKENS=262144
